<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Durable HoneyDrunk knowledge store over HoneyDrunk.Data's Entity Framework layer: source versions and their passages survive a restart and are shared by every host on one database.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HoneyDrunk.Knowledge.Providers.Data.Tests" />
    <InternalsVisibleTo Include="HoneyDrunk.Knowledge.Providers.Data.SqlServerTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HoneyDrunk.Knowledge.Abstractions\HoneyDrunk.Knowledge.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\KnowledgeStoreRules.cs" Link="Shared\KnowledgeStoreRules.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HoneyDrunk.Standards" Version="0.4.4" PrivateAssets="all" />
    <PackageReference Include="HoneyDrunk.Data.EntityFramework" Version="0.8.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="\" />
    <!-- The SQL Server table scripts, in a plain folder: nothing is added to a consumer's build. -->
    <None Include="Sql\*.sql" Pack="true" PackagePath="sql\" />
  </ItemGroup>
</Project>
